\citation{kampstra2008beanplot}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Biểu đồ bất thường cung cấp cái nhìn sâu sắc về những gì rừng hồi quy phân vị đã học được đối với một điểm dữ liệu và đặc trưng hành vi cụ thể cũng như lý do tại sao điểm dữ liệu đó (không) được coi là điểm bất thường. Các đường ngắn màu xanh lam biểu thị phần trăm có điều kiện $\tau _0,\tau _1,\ldots  ,\tau _{100}$ mà QRF đã học được (từ trên xuống dưới), đối với điểm dữ liệu và đặc trưng hành vi nhất định. Như trong biểu đồ hình hộp, hộp (màu lục lam) biểu thị tứ phân vị thứ nhất ($\tau _{25}$), trung vị ($\tau _{50}$) và tứ phân vị thứ ba ($\tau _{75}$). Vùng màu đỏ rộng hơn biểu thị mật độ xác suất được ước tính dựa trên phân vị có điều kiện. Cuối cùng, đường màu đen biểu thị giá trị thực tế mà điểm dữ liệu có.}}{14}{figure.caption.10}\protected@file@percent }
\newlabel{fig:beanplot}{{4}{14}{Biểu đồ bất thường cung cấp cái nhìn sâu sắc về những gì rừng hồi quy phân vị đã học được đối với một điểm dữ liệu và đặc trưng hành vi cụ thể cũng như lý do tại sao điểm dữ liệu đó (không) được coi là điểm bất thường. Các đường ngắn màu xanh lam biểu thị phần trăm có điều kiện $\tau _0,\tau _1,\ldots ,\tau _{100}$ mà QRF đã học được (từ trên xuống dưới), đối với điểm dữ liệu và đặc trưng hành vi nhất định. Như trong biểu đồ hình hộp, hộp (màu lục lam) biểu thị tứ phân vị thứ nhất ($\tau _{25}$), trung vị ($\tau _{50}$) và tứ phân vị thứ ba ($\tau _{75}$). Vùng màu đỏ rộng hơn biểu thị mật độ xác suất được ước tính dựa trên phân vị có điều kiện. Cuối cùng, đường màu đen biểu thị giá trị thực tế mà điểm dữ liệu có}{figure.caption.10}{}}
